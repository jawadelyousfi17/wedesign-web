// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleCategory {
  DESIGN
  DEV
  TYPOGRAPHY
  OPINION
}

enum EventStatus {
  PAST
  CURRENT
  UPCOMING
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

model TeamMember {
  id          String    @id @default(cuid())
  name        String
  role        String
  login1337   String?
  focus       String?
  year        String?
  tags        String[]
  avatarUrl   String?
  githubUrl   String?
  twitterUrl  String?
  bio         String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  articles    Article[]
}

model Article {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  content     String      @db.Text
  category    ArticleCategory
  readTime    String?     
  
  authorId    String
  author      TeamMember  @relation(fields: [authorId], references: [id])
  
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  date        DateTime
  type        String    
  location    String?   
  description String?   @db.Text
  status      EventStatus @default(UPCOMING)
  
  interestedUsers User[]  @relation("EventInterest")
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model JoinApplication {
  id          String   @id @default(cuid())
  login1337   String   @unique
  whatsapp    String
  message     String   @db.Text
  status      ApplicationStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  login1337     String?   @unique
  role          UserRole  @default(USER)
  
  submissions   FormSubmission[]
  interestedEvents CalendarEvent[] @relation("EventInterest")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Form {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  fields      Json     // Array of field objects { label, name, type, required, options? }
  isActive    Boolean  @default(true)
  
  submissions FormSubmission[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id])
  data      Json     // Object containing { fieldName: value }
  
  userId    String?  // Optional: link to a logged in user
  user      User?    @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
}
