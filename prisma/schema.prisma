// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArticleCategory {
  DESIGN
  DEV
  TYPOGRAPHY
  OPINION
}

enum EventStatus {
  PAST
  CURRENT
  UPCOMING
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
}

enum UserRole {
  USER
  ADMIN
}

model TeamMember {
  id          String    @id @default(cuid())
  name        String
  role        String
  login1337   String?
  focus       String?
  year        String?
  tags        String[]
  avatarUrl   String?
  githubUrl   String?
  twitterUrl  String?
  bio         String?   @db.Text
  
  projects    Project[] @relation("ProjectAuthor")
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?   @db.Text
  content     String?   @db.Text // Long form project details
  imageUrl    String?
  demoUrl     String?
  githubUrl   String?
  tags        String[]
  isFeatured  Boolean   @default(false)
  
  authors     TeamMember[] @relation("ProjectAuthor")
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  content     String      @db.Text
  category    ArticleCategory
  readTime    String?     // e.g. "5 MIN READ"
  
  authorId    String?
  author      User?        @relation(fields: [authorId], references: [id])
  
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  date        DateTime
  type        String    // e.g. "Workshop", "Meetup"
  location    String?   // Added location field
  description String?   @db.Text
  status      EventStatus @default(UPCOMING)
  
  interestedUsers User[]  @relation("EventInterest")
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model JoinApplication {
  id          String   @id @default(cuid())
  login1337   String   @unique
  whatsapp    String
  message     String   @db.Text
  status      ApplicationStatus @default(PENDING)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  login1337     String?   @unique
  role          UserRole  @default(USER)
  bio           String?   @db.Text
  
  submissions   FormSubmission[]
  interestedEvents CalendarEvent[] @relation("EventInterest")
  articles      Article[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Form {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?  @db.Text
  fields      Json     // Array of field objects { label, name, type, required, options? }
  isActive    Boolean  @default(true)
  
  submissions FormSubmission[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  form      Form     @relation(fields: [formId], references: [id])
  data      Json     // Object containing { fieldName: value }
  
  userId    String?  // Optional: link to a logged in user
  user      User?    @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model MerchItem {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?   @db.Text
  price       Float
  images      String[]
  colors      String[]
  sizes       String[]
  category    String?
  
  orders      MerchOrder[]
  
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MerchOrder {
  id          String    @id @default(cuid())
  itemId      String
  item        MerchItem @relation(fields: [itemId], references: [id])
  
  size        String?
  color       String?
  
  customerName    String
  customerAddress String   @db.Text
  customerPhone   String
  
  status      String    @default("PENDING") // PENDING, COMPLETED, CANCELLED
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
